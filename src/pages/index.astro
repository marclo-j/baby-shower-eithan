---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import MusicButton from '../components/MusicButton.astro';
import Hero from '../components/Hero.astro';
import Message from '../components/Message.astro';
import Countdown from '../components/Countdown.astro';
import Venue from '../components/Venue.astro';
import GiftList from '../components/GiftList.astro';
import Rsvp from '../components/Rsvp.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
---
<Layout>
  <div class="relative min-h-screen overflow-x-clip bg-sage-100">
    <Intro />
    <MusicButton />
    <main>
      <Hero />
      <Message />
      <Countdown />
      <Venue />
      <GiftList />
      <Rsvp />
    </main>
    <Footer />
    <BottomNav />
  </div>
</Layout>

<script>
  import { initReveal } from '../lib/motion';
  initReveal();
</script>

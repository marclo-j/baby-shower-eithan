---
import '../styles/global.css';
import { event } from '../config/event';
import MusicButton from '../components/MusicButton.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `Baby Shower de ${event.babyName}`,
  description = `${event.parents} te invitan al baby shower de ${event.babyName} · ${event.weekday} ${event.day} de ${event.month.toLowerCase()}, ${event.time}.`,
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#AEC0A8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Great+Vibes&family=Nunito:wght@400;600;700;800&display=swap"
    />
  </head>
  <body>
    <MusicButton />
    <slot />
  </body>
</html>

---
import { event } from '../config/event';
import CloudEdge from './deco/CloudEdge.astro';
import Cloud from './deco/Cloud.astro';
import Star from './deco/Star.astro';
import Bunting from './deco/Bunting.astro';
import Illustration from './deco/Illustration.astro';
import Sticker from './deco/Sticker.astro';

// Escena final: los dinos juntos (posiciones en % del contenedor).
// `flip` refleja la imagen para que los de la derecha miren hacia el centro.
const dinos = [
  { src: '/img/dino-estego.png', label: 'Estegosaurio', left: '1%', w: '30%', z: 3, delay: '0s' },
  { src: '/img/dino-para.png', label: 'Parasaurolophus', left: '19%', w: '24%', z: 4, delay: '-1.5s' },
  { src: '/img/dino-rex.png', label: 'T-rex verde', left: '36%', w: '28%', z: 5, delay: '-3s' },
  { src: '/img/dino-naranja.png', label: 'T-rex naranja', left: '57%', w: '24%', z: 4, delay: '-2.5s', flip: true },
  { src: '/img/dino-braquio.png', label: 'Braquiosaurio', left: '72%', w: '30%', z: 3, delay: '-2s', flip: true },
];
---
<footer data-screen-label="08 Cierre" class="relative bg-cream px-5 pt-20 pb-[130px] text-center">
  <CloudEdge color="var(--color-cream)" offset={60} />
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <Cloud left={-60} top="30%" w={200} op={0.9} dur={30} color="var(--color-sage-100)" />
    <Cloud right={-70} top="12%" w={230} op={0.9} dur={24} delay={-6} color="var(--color-sage-100)" />
    <Star left="16%" top={70} size={14} />
  </div>
  <div class="relative mx-auto flex max-w-[680px] flex-col items-center">
    <h2 data-reveal class="font-script text-[clamp(66px,17vw,112px)] leading-[1.1] font-normal text-sage-500">Te esperamos</h2>
    <div
      data-reveal
      role="img"
      aria-label="Estegosaurio, parasaurolophus, T-rex verde, T-rex naranja y braquiosaurio juntos sobre nubes"
      class="relative mt-[18px] aspect-[16/10] w-full max-w-[620px] overflow-hidden rounded-[28px] bg-[linear-gradient(var(--color-sage-150),var(--color-sage-100))]"
    >
      <Sticker src="/img/helecho.png" size={120} left={-24} top={-18} rotate={160} float={false} op={0.9} />
      <Sticker src="/img/helecho.png" size={100} right={-20} top={-10} rotate={-150} float={false} op={0.85} />
      <Sticker src="/img/flor.png" size={34} left="30%" top="12%" dur={6} />
      <Sticker src="/img/flor.png" size={26} right="30%" top="18%" rotate={40} dur={7} delay={-2} />
      {dinos.map((d) => (
        <div class="absolute bottom-[10%]" style={{ left: d.left, width: d.w, zIndex: d.z }}>
          <div class="animate-bob" style={{ animationDelay: d.delay }}>
            <div class:list={[d.flip && '-scale-x-100']}><Illustration src={d.src} label={d.label} /></div>
          </div>
        </div>
      ))}
      <Cloud left="-6%" bottom="-14%" w="44%" z={6} dur={18} />
      <Cloud left="30%" bottom="-18%" w="46%" z={6} dur={22} delay={-6} />
      <Cloud right="-8%" bottom="-14%" w="42%" z={6} dur={20} delay={-3} />
    </div>
    <div class="mt-[30px] w-full max-w-[420px]"><Bunting n={9} /></div>
    <figure data-reveal class="relative mt-9 w-[min(78%,300px)]">
      <div class="aspect-[4/5] overflow-hidden rounded-t-[999px] rounded-b-[28px] border-[6px] border-cream shadow-[0_18px_40px_-18px_rgba(74,102,80,.45)] ring-1 ring-sage-200">
        <img
          src="/img/padres.jpg"
          alt="María y Julio esperando a Eithan"
          width="900"
          height="1092"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-[50%_30%]"
        />
      </div>
      <Sticker src="/img/flor.png" size={34} right={-10} top={34} rotate={25} dur={7} />
      <Sticker src="/img/helecho.png" size={84} left={-34} bottom={-10} rotate={200} float={false} op={0.9} />
    </figure>
    <p data-reveal class="mt-7 font-display text-xl text-ink-soft italic">Con cariño,</p>
    <p data-reveal class="font-script text-[clamp(42px,10vw,56px)] leading-[1.15] text-sage-700">{event.parents}</p>
    <p class="mt-7 text-[13px] font-bold tracking-[.06em] text-ink-soft">para {event.babyName}</p>
  </div>
</footer>

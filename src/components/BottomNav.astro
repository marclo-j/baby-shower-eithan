---
const link =
  'flex min-h-11 items-center rounded-full px-4 text-sm font-extrabold text-ink no-underline transition-colors duration-300 ease-out hover:bg-sage-100 hover:text-ink';
---
<nav
  aria-label="Accesos rápidos"
  class="after-open fixed left-1/2 z-[60] flex -translate-x-1/2 gap-1 rounded-full border border-sage-300/60 bg-cream/95 p-[5px] shadow-[0_16px_34px_-16px_rgb(51_66_47/.55)] backdrop-blur-[10px]"
  style="bottom: max(14px, env(safe-area-inset-bottom))"
>
  <a href="#inicio" class={link}>Inicio</a>
  <a href="#regalos" class={link}>Regalos</a>
  <a
    href="#confirmar"
    class="flex min-h-11 items-center rounded-full bg-sage-300 px-[18px] text-sm font-extrabold text-ink no-underline transition-colors duration-300 ease-out hover:bg-sage-700 hover:text-cream"
  >Confirmar</a>
</nav>

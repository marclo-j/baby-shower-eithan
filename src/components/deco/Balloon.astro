---
interface Props {
  top?: string;
  left?: string;
  right?: string;
  size: number;
  color: string;
  dur: number;
  delay?: number;
}
const { top, left, right, size, color, dur, delay = 0 } = Astro.props;
---
<div
  aria-hidden="true"
  class="pointer-events-none absolute flex flex-col items-center"
  style={{ top, left, right, width: `${size}px`, animation: `floatY ${dur}s ease-in-out ${delay}s infinite` }}
>
  <div
    class="relative"
    style={{
      width: `${size}px`,
      height: `${size * 1.2}px`,
      borderRadius: '50% 50% 48% 48% / 55% 55% 45% 45%',
      background: color,
      boxShadow: 'inset -4px -6px 0 rgb(51 66 47 / .08)',
    }}
  >
    <div class="absolute top-[16%] left-[22%] h-[28%] w-[22%] rotate-[20deg] rounded-full bg-white/60"></div>
  </div>
  <div class="h-1.5 w-2" style={{ background: color, clipPath: 'polygon(50% 0, 100% 100%, 0 100%)' }}></div>
  <div class="w-px bg-ink/30" style={{ height: `${size * 1.5}px` }}></div>
</div>

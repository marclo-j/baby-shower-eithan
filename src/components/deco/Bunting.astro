---
// Guirnalda de banderines en arco
interface Props {
  n: number;
}
const { n } = Astro.props;
const cols = ['var(--color-sage-300)', 'var(--color-sand)', 'var(--color-sage-200)', 'var(--color-cream)'];
const flags = Array.from({ length: n }, (_, i) => {
  const x = 4 + i * (92 / (n - 1));
  const u = (x - 50) / 52;
  const y = 30 * Math.sqrt(Math.max(0, 1 - u * u));
  return { x, y, rot: (-u * 22).toFixed(1), color: cols[i % cols.length] };
});
---
<div aria-hidden="true" class="relative h-16 w-full">
  <div class="absolute -top-[30px] -right-[2%] -left-[2%] h-[60px] rounded-b-[50%] border-b-[1.5px] border-ink/25"></div>
  {flags.map((f) => (
    <div
      class="absolute -ml-3 h-[30px] w-6 origin-top"
      style={{
        left: `${f.x}%`,
        top: `${f.y - 1}px`,
        background: f.color,
        clipPath: 'polygon(0 0, 100% 0, 50% 100%)',
        transform: `rotate(${f.rot}deg)`,
        filter: 'drop-shadow(0 1px 0 rgb(51 66 47 / .12))',
      }}
    ></div>
  ))}
</div>

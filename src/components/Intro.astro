---
import { event } from '../config/event';
import Cloud from './deco/Cloud.astro';
import Star from './deco/Star.astro';
import Illustration from './deco/Illustration.astro';
---
<div id="intro" data-phase="closed" data-screen-label="00 Intro" class="intro fixed inset-0 z-[100] flex items-center justify-center overflow-hidden px-4 pt-11 pb-6">
  <Cloud left={-40} top="5%" w={170} op={0.95} dur={22} />
  <Cloud right={-50} top="16%" w={150} op={0.9} dur={28} delay={-6} />
  <Cloud left={-40} bottom="9%" w={200} dur={26} />
  <Cloud right={-50} bottom="3%" w={190} dur={19} delay={-4} />
  <Star left="8%" top="30%" size={18} color="var(--color-cream)" />
  <Star right="9%" top="42%" size={14} color="var(--color-cream)" delay={1} />
  <Star left="12%" bottom="28%" size={12} color="var(--color-sage-500)" delay={2} />

  <div class="relative flex h-[min(84svh,660px)] w-[min(88vw,390px)] flex-col items-center justify-evenly rounded-t-[200px] rounded-b-[22px] bg-cream px-[22px] pt-[58px] pb-[22px] text-center shadow-[0_2px_6px_rgb(51_66_47/.06),0_30px_60px_-28px_rgb(51_66_47/.45)]">
    <div aria-hidden="true" class="pointer-events-none absolute inset-[9px] rounded-t-[191px] rounded-b-[15px] border border-gold"></div>

    <!-- Moño -->
    <div aria-hidden="true" class="pointer-events-none absolute -top-[30px] left-1/2 h-[84px] w-[150px] -translate-x-1/2">
      <div class="absolute top-2 left-2 h-10 w-[62px] -rotate-[16deg] rounded-[50%] border-2 border-sage-500 bg-sage-300"></div>
      <div class="absolute top-2 right-2 h-10 w-[62px] rotate-[16deg] rounded-[50%] border-2 border-sage-500 bg-sage-300"></div>
      <div class="absolute top-11 left-[52px] h-[42px] w-3 rotate-[22deg] rounded border-2 border-sage-500 bg-sage-300"></div>
      <div class="absolute top-11 right-[52px] h-[42px] w-3 -rotate-[22deg] rounded border-2 border-sage-500 bg-sage-300"></div>
      <div class="absolute top-4 left-[61px] h-[26px] w-7 rounded-[10px] border-2 border-sage-500 bg-sage-200"></div>
    </div>

    <div class="flex flex-col items-center">
      <div class="pl-[.14em] font-display text-[clamp(40px,12vw,58px)] leading-[.95] font-medium tracking-[.14em] text-sage-500">BABY</div>
      <div class="pl-[.14em] font-display text-[clamp(40px,12vw,58px)] leading-[.95] font-medium tracking-[.14em] text-sage-500">SHOWER</div>
      <div class="mt-1 font-script text-[clamp(46px,13vw,64px)] leading-[1.15] text-sage-700">{event.babyName}</div>
    </div>

    <div class="flex flex-col items-center gap-3.5">
      <!-- Huevo: se bambolea esperando el toque; al tocarlo se rompe y nace el dino (video) -->
      <div
        id="egg"
        role="button"
        tabindex="0"
        aria-label="Abrir la invitación"
        class="egg relative aspect-[600/756] h-[min(250px,28svh)] cursor-pointer rounded-[24px] outline-none focus-visible:ring-4 focus-visible:ring-sage-300/60"
      >
        <!-- El fondo del video ya está igualado al crema de la tarjeta -->
        <video
          id="egg-video"
          class="pointer-events-none h-full w-full object-contain"
          poster="/video/huevo-inicio.webp"
          muted
          playsinline
          preload="auto"
          disablepictureinpicture
          aria-hidden="true"
        >
          <!-- MP4 primero: Safari en iOS puede elegir el WebM y no reproducirlo -->
          <source src="/video/huevo.mp4" type="video/mp4" />
          <source src="/video/huevo.webm" type="video/webm" />
        </video>
      </div>
      <div class="egg-hint eyebrow">Toca el huevito para abrir</div>
    </div>

    <div class="flex w-full items-end justify-between gap-3">
      <div class="h-[min(118px,30vw)] w-[min(96px,24vw)]"><Illustration src="/img/dino-para.png" label="Dinosaurio celeste" /></div>
      <div class="pb-2.5 font-display text-base tracking-[.2em] text-gold">✦ ✦ ✦</div>
      <!-- La imagen mira a la derecha: se refleja para que mire hacia el centro -->
      <div class="h-[min(118px,30vw)] w-[min(96px,24vw)] -scale-x-100"><Illustration src="/img/dino-naranja.png" label="Dinosaurio naranja" /></div>
    </div>
  </div>
</div>

<style>
  .intro {
    background-color: var(--color-sage-200);
    background-image:
      radial-gradient(circle at 12px 12px, rgb(125 148 120 / 0.3) 2px, transparent 2.6px),
      radial-gradient(circle at 38px 40px, rgb(255 253 248 / 0.85) 3px, transparent 3.6px);
    background-size: 52px 56px;
    transition:
      opacity 0.7s ease-out,
      transform 0.9s ease-out;
  }
  /* Bamboleo desde la base, con pausas, como si algo se moviera adentro */
  .intro[data-phase="closed"] .egg video {
    transform-origin: 50% 86%;
    animation: eggWobble 2.6s ease-in-out infinite;
  }
  @keyframes eggWobble {
    0%, 55%, 100% { transform: rotate(0); }
    62% { transform: rotate(-4deg); }
    70% { transform: rotate(3.5deg); }
    77% { transform: rotate(-2.5deg); }
    84% { transform: translateY(-3%) rotate(1deg); }
    91% { transform: rotate(0); }
  }
  .egg-hint {
    transition: opacity 0.4s ease-out;
  }
  .intro:not([data-phase="closed"]) .egg {
    cursor: default;
  }
  .intro:not([data-phase="closed"]) .egg-hint {
    opacity: 0;
  }
  /* Solo con movimiento reducido: fade simple en lugar de las hojas */
  .intro[data-phase="fading"] {
    opacity: 0;
    transform: scale(1.04);
  }
</style>

<script>
  import { prefersReducedMotion } from '../lib/motion';
  import { playLeafTransition, LEAF_SRC } from '../lib/leaves';

  const intro = document.getElementById('intro');
  const egg = document.getElementById('egg');
  const video = document.getElementById('egg-video') as HTMLVideoElement | null;

  if (intro && egg && video) {
    document.documentElement.style.overflow = 'hidden';
    const reduced = prefersReducedMotion();
    const setPhase = (p: string) => (intro.dataset.phase = p);
    const HATCHED_SRC = '/video/huevo-final.webp';
    // Precarga la hoja (o el dino ya nacido) para que nada espere a la descarga
    new Image().src = reduced ? HATCHED_SRC : LEAF_SRC;

    const revealPage = () => {
      intro.remove();
      document.documentElement.style.overflow = '';
      window.scrollTo(0, 0);
    };
    const startHero = () => {
      document.documentElement.classList.add('invite-open');
      document.dispatchEvent(new CustomEvent('invite:open'));
    };

    // Las hojas cubren la pantalla, se mantienen 1.5 s y se despejan hacia los lados.
    let leavesStarted = false;
    const startLeaves = () => {
      if (leavesStarted) return;
      leavesStarted = true;
      playLeafTransition({ onCovered: revealPage, onClearing: startHero, holdMs: 1500 });
    };

    // Al volver desde /regalos (que deja esta marca) no se repite el huevo
    let seen = false;
    try {
      seen = sessionStorage.getItem('skip-intro') === '1';
      sessionStorage.removeItem('skip-intro');
    } catch {}
    if (seen) {
      intro.remove();
      document.documentElement.style.overflow = '';
      startHero();
      // El ancla (#confirmar, #inicio…) se resuelve cuando ya no está el overlay
      if (location.hash) setTimeout(() => document.querySelector(location.hash)?.scrollIntoView({ behavior: 'instant' }), 0);
    }

    const open = () => {
      if (seen || intro.dataset.phase !== 'closed') return;
      setPhase('opening');
      // La música se inicia en el mismo gesto del usuario (requisito de los navegadores)
      document.dispatchEvent(new CustomEvent('invite:music', { detail: { play: true } }));

      if (reduced) {
        // Sin animación: se muestra directamente el dino ya nacido
        video.poster = HATCHED_SRC;
        setTimeout(() => setPhase('fading'), 900);
        setTimeout(() => (revealPage(), startHero()), 1100);
        return;
      }

      // El huevo se rompe y nace el dino; al terminar el video siguen las hojas.
      // Respaldo por si el video no puede reproducirse o no dispara "ended".
      video.addEventListener('ended', startLeaves, { once: true });
      const fallback = setTimeout(startLeaves, 6000);
      // iOS solo permite reproducir sin interacción extra si el video está silenciado
      video.muted = true;
      video.play().catch(() => {
        clearTimeout(fallback);
        startLeaves();
      });
    };

    if (!seen) egg.addEventListener('click', open);
    egg.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open();
      }
    });
  }
</script>
